# ---- LLM 来源 ----
# sensenova = 商汤云 API；local = WSL 里的 llama.cpp（llama-server）
# 也可在 Web 版「⚙ 设置」里按世界配置服务商，会覆盖此处并持久化到 设置.json
LLM_PROVIDER=local

# 商汤 SenseNova（LLM_PROVIDER=sensenova 时需要）
SENSENOVA_API_KEY=

# 本地 llama.cpp（LLM_PROVIDER=local 时生效）
LOCAL_BASE_URL=http://127.0.0.1:8137/v1
LOCAL_MODEL_ID=qwen3.5-9b
LOCAL_CONTEXT=16384

# Web 模式访问令牌（不设置或留空 = 关闭鉴权，局域网内打开页面即可使用）
# WEB_TOKEN=
